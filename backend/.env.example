JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
PORT=8080

# Production: set GIN_MODE=release (Render sets this automatically via render.yaml)
# GIN_MODE=release

# Local development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfoliopro
DB_SSLMODE=disable

# PromptPay / บัญชีโอนเงิน (ลูกค้าโอนแล้วแนบสลิป)
PROMPTPAY_PHONE=0645238150
BANK_NAME=พร้อมเพย์
BANK_ACCOUNT_NAME=PortfolioPro Studio
BANK_ACCOUNT_NUMBER=0645238150

# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Comma-separated extra frontend URLs (e.g. Vercel preview)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Admin — email ที่จะได้ role admin อัตโนมัติ + รับแจ้งเตือนออเดอร์
ADMIN_EMAIL=jakkapant32@gmail.com

# SITE_URL — ลิงก์ในอีเมลแจ้งเตือน (production: https://portfoliopro.studio)
# SITE_URL=http://localhost:5173

